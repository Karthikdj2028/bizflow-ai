# ==============================================================================
# BizFlow AI — Environment Configuration Template (.env.example)
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit actual secret keys or database credentials to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="BizFlow AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration (PostgreSQL 16+ via Psycopg 3)
# Example local format: postgresql+psycopg://<username>:<password>@localhost:5432/<dbname>
DATABASE_URL="postgresql+psycopg://bizflow_user:your_password_here@localhost:5432/bizflow_dev"

# Authentication & Security
# Generate a cryptographically secure key: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Default Workspace Currency (ISO 4217 standard)
# Recommended: INR (₹) for Indian academic capstone context, or USD ($), EUR (€), GBP (£)
DEFAULT_CURRENCY="INR"

# CORS Allowed Origins (JSON Array of strings)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
